<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovaLauncher.App.ViewModels"
             x:Class="NovaLauncher.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="880" Margin="28,24">

            <!-- 页面标题 -->
            <StackPanel Spacing="2">
                <TextBlock Text="主页" FontSize="26" FontWeight="Bold" Foreground="#E8EAF6"/>
                <TextBlock Text="管理你的账户与启动配置" FontSize="12" Foreground="#5C6080"/>
            </StackPanel>

            <!-- 账户卡片 -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <!-- 头像 -->
                        <Border Width="56" Height="56" CornerRadius="28" Background="#E0E2F5"
                                VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding AccountName, FallbackValue='未登录'}" FontSize="18" FontWeight="SemiBold" Foreground="#E8EAF6"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#E0E2F5" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{Binding AccountType, FallbackValue='离线'}" FontSize="11" Foreground="#7C4DFF"/>
                                </Border>
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#69F0AE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 登录按钮组 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding AccountName}" PlaceholderText="游戏昵称（离线登录用）"
                                 IsEnabled="{Binding !IsBusy}" Width="220"/>
                        <Button Content="离线登录" Classes="flat" Command="{Binding LoginOfflineCommand}"/>
                        <Button Content="微软登录" Classes="flat" Command="{Binding LoginMicrosoftCommand}"/>
                        <Button Content="外置登录" Classes="flat" Command="{Binding ToggleExternalPanelCommand}"/>
                    </StackPanel>

                    <!-- 外置登录面板 -->
                    <Border IsVisible="{Binding ShowExternalPanel}" Background="#1C1D2E" CornerRadius="14" Padding="14"
                            BorderBrush="#D8DBE8" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="第三方认证服务器登录（外置登录）" FontSize="13" FontWeight="SemiBold" Foreground="#9AA0B8"/>
                            <TextBox Text="{Binding ExternalApi}" PlaceholderText="认证服务器 API，如 https://littleskin.cn/api/yggdrasil"/>
                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding ExternalUser}" PlaceholderText="账号 / 邮箱"/>
                                <TextBox Grid.Column="1" Text="{Binding ExternalPassword}" PlaceholderText="密码" PasswordChar="●"/>
                                <Button Grid.Column="2" Content="登录" Classes="accent" Command="{Binding ExternalLoginCommand}"/>
                            </Grid>
                            <TextBlock Text="通过 authlib-injector 使用第三方皮肤站账号登录，可进入开启正版验证的服务器。"
                                       FontSize="11" Foreground="#5C6080" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 启动配置卡片 -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <TextBlock Text="启动配置" FontSize="18" FontWeight="SemiBold" Foreground="#E8EAF6"/>

                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏版本" VerticalAlignment="Center" FontSize="13" Foreground="#9AA0B8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Versions}"
                                  SelectedItem="{Binding SelectedVersion}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Java 运行时" VerticalAlignment="Center" FontSize="13" Foreground="#9AA0B8"/>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding JavaList}"
                                      SelectedItem="{Binding SelectedJava}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="⬇ 下载 Java" Classes="flat" FontSize="12"
                                    Command="{Binding DownloadJavaCommand}"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="内存 (MB)" VerticalAlignment="Center" FontSize="13" Foreground="#9AA0B8"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <TextBox Text="{Binding MinMemoryMb}" Width="130" PlaceholderText="最小"/>
                            <TextBlock Text="—" VerticalAlignment="Center" Foreground="#5C6080"/>
                            <TextBox Text="{Binding MaxMemoryMb}" Width="130" PlaceholderText="最大"/>
                        </StackPanel>
                    </Grid>

                    <!-- 大启动按钮 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="▶  启动游戏" Classes="launch" Command="{Binding LaunchCommand}"/>
                        <Button Content="下载补全" Classes="flat" Command="{Binding DownloadVersionCommand}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 进度卡片 -->
            <Border IsVisible="{Binding ShowProgress}" Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="下载进度" FontSize="14" FontWeight="SemiBold" Foreground="#E8EAF6"/>
                    <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#9AA0B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 日志卡片 -->
            <Border IsVisible="{Binding ShowGameLog}" Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="游戏 / 启动日志" FontSize="14" FontWeight="SemiBold" Foreground="#E8EAF6"/>
                    <TextBox Text="{Binding GameLog}" Height="200" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             FontFamily="Consolas, monospace" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

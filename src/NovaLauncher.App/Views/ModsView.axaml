<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovaLauncher.App.ViewModels"
             x:Class="NovaLauncher.App.Views.ModsView"
             x:DataType="vm:ModsViewModel">
    <StackPanel Spacing="16" MaxWidth="860">
        <TextBlock Text="模组管理" Classes="section"/>
        <TextBlock Text="{Binding Status}" Classes="status"/>

        <Border Background="#FFFFFF" CornerRadius="14" Padding="18">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="160,*" ColumnSpacing="10">
                    <TextBlock Text="选择版本" VerticalAlignment="Center" Classes="label"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion}"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="mods 目录中的文件（.jar 为模组，.zip 为资源包）" Classes="label" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="识别校验" Classes="flat" Command="{Binding VerifySelectedCommand}"/>
                        <Button Content="切换版本" Classes="flat" Command="{Binding SwitchVersionCommand}"/>
                        <Button Content="一键提取" Classes="flat" Command="{Binding ExtractNestedCommand}"/>
                        <Button Content="依赖排序" Classes="flat" Command="{Binding SortDepsCommand}"/>
                        <Button Content="检测冲突" Classes="flat" Command="{Binding DetectConflictsCommand}"/>
                        <Button Content="检查依赖" Classes="flat" Command="{Binding CheckDepsCommand}"/>
                        <Button Content="打开模组文件夹" Classes="flat" Command="{Binding OpenFolderCommand}"/>
                    </StackPanel>
                </Grid>

                <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" Height="260">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="70,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="启用" Foreground="#7CD4A8" VerticalAlignment="Center"
                                           IsVisible="{Binding Enabled}"/>
                                <TextBlock Grid.Column="0" Text="禁用" Foreground="#9AA4B0" VerticalAlignment="Center"
                                           IsVisible="{Binding !Enabled}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                    <TextBlock Text="{Binding Kind}" Classes="label" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="label" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Content="切换" Classes="flat"
                                            Command="{Binding $parent[ListBox].DataContext.ToggleSelectedCommand}"/>
                                    <Button Content="删除" Classes="danger"
                                            Command="{Binding $parent[ListBox].DataContext.DeleteSelectedCommand}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Background="#FFFFFF" CornerRadius="14" Padding="18" IsVisible="{Binding ShowVersionPanel}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="版本切换 / 降级" Classes="section" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VersionPanelTitle}" FontWeight="SemiBold" Foreground="#7CD4A8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕ 关闭" Classes="flat" Command="{Binding CloseVersionPanelCommand}"/>
                </Grid>
                <TextBlock Text="从 Modrinth 读取该模组的可用版本。选中一个版本后点「下载替换」，旧文件会移到 mods/.versions-backup/ 备份。适用于升级或降级。" Classes="label" FontSize="11" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding RemoteVersions}" SelectedItem="{Binding SelectedRemoteVersion}" Height="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding VersionNumber}" Classes="label" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="下载替换" Classes="accent" HorizontalAlignment="Right"
                        Command="{Binding ApplyRemoteVersionCommand}" IsEnabled="{Binding !IsRemoteBusy}"/>
            </StackPanel>
        </Border>

        <Border Background="#FFFFFF" CornerRadius="14" Padding="18" IsVisible="{Binding ShowVerifyPanel}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="模组识别校验" Classes="section" FontSize="14" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕ 关闭" Classes="flat" Command="{Binding CloseVerifyPanelCommand}"/>
                </Grid>
                <TextBox Text="{Binding VerifySummary}" Classes="code" AcceptsReturn="True" MinHeight="160"
                         IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Background="#FFFFFF" CornerRadius="14" Padding="18" IsVisible="{Binding ShowConflicts}">
            <StackPanel Spacing="10">
                <TextBlock Text="⚠ 模组冲突" Classes="section" FontSize="14"/>
                <TextBlock Text="同一模组存在多个 jar，可能导致无法启动或报错，请保留一个版本、删除其余。" Classes="label" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Conflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4" Margin="0,0,0,10">
                                <TextBlock Text="{Binding ModId, StringFormat='模组 {0}'}" FontWeight="SemiBold" Foreground="#FFD76A"/>
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" Foreground="#FF9D8A" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Background="#FFFFFF" CornerRadius="14" Padding="18" IsVisible="{Binding ShowMissingDeps}">
            <StackPanel Spacing="10">
                <TextBlock Text="⚠ 缺失的前置模组" Classes="section" FontSize="14"/>
                <TextBlock Text="以下模组声明了必装的依赖，但当前 mods 目录中缺少对应模组，启动时可能报错。可用「模组下载」搜索安装。" Classes="label" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding MissingDeps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                                <TextBlock Text="缺少依赖：" Foreground="#FF9D8A" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding DepModId}" FontWeight="SemiBold" Foreground="#FFD76A" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding VersionRange}" Classes="label" FontSize="11" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Mod}" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
